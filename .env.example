POSTGRES_ADMIN_PASSWORD=local-postgres-admin-only
APP_DB=saas_platform
APP_DB_USER=saas_app
APP_DB_PASSWORD=local-development-only
DATABASE_URL=postgres://saas_app:local-development-only@postgres:5432/saas_platform
RUST_LOG=info,saas_api=debug
API_PORT=3000
SESSION_TTL_SECONDS=28800
PASSWORD_RESET_TTL_SECONDS=1800
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=SaaS Platform <no-reply@example.test>
VITE_API_BASE_URL=/api

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
